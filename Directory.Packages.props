<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Allow floating versions (e.g. 1.*) under Central Package Management -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating: always restore the latest published 1.x ComicsProvider automatically -->
    <PackageVersion Include="ParagRaut.ComicsProvider" Version="1.*" />
  </ItemGroup>

</Project>
