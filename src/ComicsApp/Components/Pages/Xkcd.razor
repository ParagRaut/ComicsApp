@page "/xkcd"
@using ComicsApp.Services

@rendermode InteractiveServer

@inject XkcdComicState State

<PageTitle>XKCD Reader</PageTitle>

<div class="reader">
    <header class="reader-header">
        <h1>XKCD Reader</h1>
        <p>Load a random comic, then use the controls to move through your history.</p>
    </header>

    <div class="reader-controls">
        <button type="button" class="btn btn-outline" disabled="@(!State.CanGoBack || _isLoading)" @onclick="GoToPrevious">
            &larr; Prev
        </button>
        <button type="button" class="btn btn-primary" disabled="@_isLoading" @onclick="GoToNext">
            Next &rarr;
        </button>
    </div>

    <div class="comic-card">
        <SpinLoader IsLoading="_isLoading">
            <LoadingTemplate>
                <div class="loader-wrap">
                    <Swing Center="true" Size="80px"></Swing>
                </div>
            </LoadingTemplate>
            <ContentTemplate>
                <picture>
                    <img src="@State.CurrentComic" class="comic-img" alt="XKCD comic">
                </picture>
            </ContentTemplate>
        </SpinLoader>
    </div>
</div>

@code {

    private bool _isLoading;

    private void GoToPrevious() => State.GoToPrevious();

    private async Task GoToNext()
    {
        if (_isLoading)
        {
            return;
        }

        _isLoading = true;
        try
        {
            await State.GoToNextAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }
}