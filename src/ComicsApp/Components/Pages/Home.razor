@page "/"

<PageTitle>Home</PageTitle>

<section class="hero">
    <span class="hero-badge">Built with Blazor</span>
    <h1 class="hero-title">Welcome to <span>Comics App</span></h1>
    <p class="hero-subtitle">
        Browse a random stream of comics from XKCD in a clean, distraction-free reader.
        Flip back and forth through everything you've discovered.
    </p>
    <a class="btn btn-primary btn-lg" href="xkcd">Start reading &rarr;</a>

    <div class="feature-grid">
        <div class="feature-card">
            <div class="feature-icon">🎲</div>
            <h3>Random comics</h3>
            <p>Pull a fresh, randomly selected XKCD comic with a single click.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">⏪</div>
            <h3>Browse history</h3>
            <p>Move back and forth through every comic you've loaded this session.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">⚡</div>
            <h3>Fast &amp; clean</h3>
            <p>A lightweight interface that keeps the focus on the comics.</p>
        </div>
    </div>
</section>