@page "/"
@using ComicsApp.Services
@rendermode InteractiveServer
@implements IAsyncDisposable

@inject ComicReaderState State
@inject IJSRuntime JS

<PageTitle>Comics</PageTitle>

<div class="feed">
    <header class="feed-hero">
        <h1>An endless comic feed</h1>
        <p>A never-ending shuffle of XKCD, SMBC, Dinosaur Comics, PHD, Poorly Drawn Lines, War and Peas, Perry Bible Fellowship &amp; Reddit memes. Just keep scrolling.</p>
    </header>

    @foreach (var item in State.Items)
    {
        <article class="comic-card">
            <span class="comic-badge">@item.Source</span>
            <img src="@item.Url"
                 alt="@item.Source comic"
                 loading="lazy"
                 onerror="this.closest('.comic-card').classList.add('is-broken')" />
            <div class="comic-fallback">This one refused to load — keep scrolling for more. 🤷</div>
        </article>
    }

    <div @ref="_sentinel" class="feed-sentinel">
        @if (_isLoading || !State.HasItems)
        {
            <div class="comic-loader" role="status" aria-label="Loading comics">
                <span></span><span></span><span></span>
            </div>
        }
    </div>
</div>

<button type="button" class="shuffle-fab" title="Shuffle a fresh feed" @onclick="ShuffleAsync">
    <span class="shuffle-icon">🎲</span>
</button>

@code {
    private ElementReference _sentinel;
    private DotNetObjectReference<Comics>? _selfRef;
    private bool _isLoading;
    private bool _observerReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (!State.HasItems)
        {
            await LoadMoreAsync();
        }

        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("comicFeed.init", _sentinel, _selfRef);
        _observerReady = true;
    }

    [JSInvokable]
    public Task LoadMoreFromJs() => LoadMoreAsync();

    private async Task LoadMoreAsync()
    {
        if (_isLoading)
        {
            return;
        }

        _isLoading = true;
        StateHasChanged();
        try
        {
            await State.LoadMoreAsync();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ShuffleAsync()
    {
        State.Clear();
        await JS.InvokeVoidAsync("comicFeed.scrollTop");
        await LoadMoreAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_observerReady)
        {
            try
            {
                await JS.InvokeVoidAsync("comicFeed.dispose");
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfRef?.Dispose();
    }
}
